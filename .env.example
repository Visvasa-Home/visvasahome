# VisvasaHome - Live Production Environment Variables Template
# Copy this file to '.env' or '.env.local' and populate with your own live credentials.

# =========================================================================
# 1. Razorpay Payment Gateway Credentials
# =========================================================================
# Your Razorpay Key ID (usually starts with rzp_live_... or rzp_test_...)
VITE_RAZORPAY_KEY_ID=your_razorpay_key_id_here

# Your Razorpay Key Secret (needed on server-side functions)
VITE_RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# =========================================================================
# 2. Twilio Credentials (OTP SMS & WhatsApp Notifications)
# =========================================================================
# Your Twilio Account SID (found on Twilio Console Dashboard)
VITE_TWILIO_ACCOUNT_SID=your_twilio_account_sid_here

# Your Twilio Auth Token (found on Twilio Console Dashboard)
VITE_TWILIO_AUTH_TOKEN=your_twilio_auth_token_here

# Your Twilio Phone Number (with country code, e.g., +12345678900)
VITE_TWILIO_PHONE_NUMBER=your_twilio_phone_number_here

# Your Twilio WhatsApp Sandbox/Approved Number (e.g., whatsapp:+14155238886)
VITE_TWILIO_WHATSAPP_NUMBER=whatsapp:your_twilio_whatsapp_number_here

# =========================================================================
# 3. Backend Connection (Supabase Backend Client)
# =========================================================================
# Your Supabase Project URL (found in project settings API tab)
VITE_SUPABASE_URL=your_supabase_project_url_here

# Your Supabase Anonymous Public Key (found in project settings API tab)
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
