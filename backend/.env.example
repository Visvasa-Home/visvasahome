# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─── Database ─────────────────────────────────────────────────────────────────
POSTGRES_USER=visvasahome
POSTGRES_PASSWORD=visvasahome123
POSTGRES_DB=visvasahome
DATABASE_URL="postgresql://visvasahome:visvasahome123@localhost:5432/visvasahome"

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=redis123
REDIS_URL="redis://:redis123@localhost:6379"

# ─── Kafka ────────────────────────────────────────────────────────────────────
KAFKA_BROKERS="localhost:9092"
KAFKA_CLIENT_ID=visvasahome-backend
KAFKA_GROUP_ID=visvasahome-group

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_change_in_production_32chars
JWT_REFRESH_SECRET=your_refresh_secret_key_change_in_production_32c
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Razorpay ─────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
# Commission percentage kept by platform (e.g., 20%)
PLATFORM_COMMISSION_PCT=20

# ─── Twilio (SMS & WhatsApp) ──────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+91xxxxxxxxxx

# ─── Firebase (FCM Push Notifications) ───────────────────────────────────────
FCM_PROJECT_ID=your-firebase-project-id
FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nXXXXXX\n-----END PRIVATE KEY-----\n"
FCM_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com

# ─── Email (SMTP) ─────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@visvasahome.com
SMTP_PASS=your_smtp_app_password
EMAIL_FROM="Visva Sahome <noreply@visvasahome.com>"

# ─── Google Maps ──────────────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# ─── AWS S3 (File Storage) ────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=ap-south-1
AWS_S3_BUCKET=visvasahome-uploads

# ─── KYC (Hyperverge) ─────────────────────────────────────────────────────────
HYPERVERGE_APP_ID=your_hyperverge_app_id
HYPERVERGE_APP_KEY=your_hyperverge_app_key
# Set to "true" to use mock KYC in development
KYC_MOCK_MODE=true

# ─── Service URLs (for API Gateway) ──────────────────────────────────────────
AUTH_SERVICE_URL=http://localhost:3001
USER_SERVICE_URL=http://localhost:3002
PARTNER_SERVICE_URL=http://localhost:3003
CATALOG_SERVICE_URL=http://localhost:3004
BOOKING_SERVICE_URL=http://localhost:3005
PAYMENT_SERVICE_URL=http://localhost:3006
NOTIFICATION_SERVICE_URL=http://localhost:3007
RATING_SERVICE_URL=http://localhost:3008
ADMIN_SERVICE_URL=http://localhost:3009
MATCHING_SERVICE_URL=http://localhost:3010

# ─── Matching ─────────────────────────────────────────────────────────────────
# Maximum search radius in meters
MATCH_RADIUS_METERS=10000
# Max partners to notify before failing a booking
MAX_MATCH_ATTEMPTS=5
# Seconds to wait for partner to accept before trying next
PARTNER_ACCEPT_TIMEOUT_SEC=60

# ─── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,https://admin.visvasahome.com

# ─── Security & Audit ─────────────────────────────────────────────────────────
PII_ENCRYPTION_KEY=generate_with_fernet_and_put_32_byte_base64_here
AUDIT_SECRET_KEY=your_secure_audit_secret_key
RATE_LIMIT_PER_MINUTE=100

# ─── Observability (OpenTelemetry / Jaeger) ───────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
